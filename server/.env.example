# ─── 필수 ───
# 배포에서는 반드시 무작위 값으로 교체 (기본값이면 서버가 기동을 거부함)
SECRET_KEY=change-me-to-a-long-random-string

# DB: 기본 SQLite. 데이터 영속이 필요하면 Postgres 권장 (Neon/Supabase 무료)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///smart_breath.db

# ESP32 데모/폴백 토큰 (기기별 토큰이 없을 때만 사용)
DEVICE_TOKEN=esp32-device-token-change-me

# ─── 개발 기본값 ───
FLASK_ENV=development
# 개발은 threading, 배포는 eventlet
SOCKETIO_ASYNC_MODE=threading
# 로컬 Vite dev 서버 출처 (same-origin 배포 시에는 불필요)
CORS_ORIGINS=http://localhost:5173

# ─── 프론트/백엔드 도메인을 분리 배포할 때만 ───
# CORS_ORIGINS=https://your-frontend.example.com
# SESSION_COOKIE_SAMESITE=None
# SESSION_COOKIE_SECURE=true
